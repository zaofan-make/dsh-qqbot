{
  "name": "@zaofan/dsh-qqbot",
  "version": "1.11.29",
  "description": "QQ Bot IM channel plugin for deepseek-harness (dsh)",
  "type": "module",
  "main": "./entry.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./entry.js"
    },
    "./channel-tools": {
      "types": "./dist/channel-tools.d.ts",
      "import": "./dist/channel-tools.js"
    },
    "./sticker-store": {
      "types": "./dist/features/sticker-store.d.ts",
      "import": "./dist/features/sticker-store.js"
    },
    "./schedule-store": {
      "types": "./dist/features/schedule-store.d.ts",
      "import": "./dist/features/schedule-store.js"
    },
    "./client": "./client/qqbot-settings.js",
    "./session-registry": "./dist/features/session-registry.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:prepare-test-pkg": "node scripts/prepare-test-pkg.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaofan-make/dsh-qqbot.git"
  },
  "homepage": "https://github.com/zaofan-make/dsh-qqbot#readme",
  "bugs": {
    "url": "https://github.com/zaofan-make/dsh-qqbot/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qqbot",
    "qq-bot",
    "chatbot",
    "ai-agent",
    "cordis",
    "plugin",
    "llm"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "docs/extension-contract.md",
    "docs/USER-GUIDE.md",
    "docs/botplay-contract.md",
    "docs/host-services.md",
    "examples",
    "client",
    "cordis.patch.yml",
    "settings-host.js",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "voice-convert.mjs",
    "scripts/download-model.mjs",
    "scripts/fix-dsh-016-presets.ps1",
    "entry.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "js-yaml": "^4.1.0",
    "lamejs-fixed": "^1.2.2",
    "silk-wasm": "^3.7.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@tencent-connect/qqbot-connector": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
